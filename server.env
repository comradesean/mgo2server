# mgo2server — operator settings.
#
# Every container in compose.yaml reads this file. Edit a value, then restart the affected
# services; nothing here is read at runtime, so a running server keeps the value it started with.
#
#   docker compose up -d --force-recreate gate account gamelobby automatching \
#       basictraining combattraining web
#
# NOTHING IN THIS FILE IS PROTOCOL. The game does not send, validate or know about any of these.
# They are our choices — the client only renders whatever answer we give it. Where a value is
# inherited from somewhere rather than chosen, it says so, because inheriting another project's
# policy is usually a bug rather than a default.
#
# Defaults live in the code, not here (see mgo2server.common.Policy). Deleting this file or
# commenting out a line leaves the server on its documented default rather than breaking it, so
# it is safe to strip back to only what you actually want to change.
#
# Syntax is docker compose's env_file: KEY=value, one per line, # for comments. No quotes, no
# shell expansion, no ${...} — the value is taken literally to end of line.
#
# No secrets. This file is committed. MGO2SERVER_DB_PASSWORD is injected separately and must not
# be added here.


# ---------------------------------------------------------------------------------------------
# Cooldowns
#
# All four default to a week. That figure is a player report about the retail service, not a
# value read out of MGO2.elf, so it is a defensible default rather than a fact. Set any of them
# to 0 to disable the wait entirely, which is usually what a test deployment wants.
#
# The client cannot show a countdown for any of these. The strings exist ("You must wait another
# %d hours %d minutes", and the disband equivalents) but are orphaned in this build — referenced
# by no instruction — so a refusal inside the cooldown shows a plain sentence with no number.
# Setting a long cooldown therefore gives the player no way to tell how long is left.
# ---------------------------------------------------------------------------------------------

# How long a character must exist before it can be deleted.
MGO2SERVER_CHARACTER_DELETE_COOLDOWN_HOURS=168

# How long a clan must exist before its leader can disband it.
MGO2SERVER_CLAN_DISBAND_COOLDOWN_HOURS=168

# How long between putting one clan emblem on display and the next.
#
# This one is entirely ours to enforce. Emblem Edit warns about a spam filter, but nothing
# client-side implements it on this build — without a server refusal the emblem can be
# re-displayed as fast as the player can press the button. This defaulted to one hour while its
# two siblings defaulted to a week, for no reason beyond the order they were written.
#
# SET TO 0 FOR TESTING, 2026-07-27. The emblem set/delete cycle is under investigation and a
# week-long cooldown means a database edit between every attempt. Put this back to 168 before
# this is a deployment anyone else plays on.
MGO2SERVER_CLAN_EMBLEM_COOLDOWN_HOURS=0

# How long after leaving a clan before a character may apply to join one.
#
# Policy twice over. That a wait exists is the game's own — it carries the sentence and has a
# result code for it. Both the length and the decision to measure it from leaving a clan, rather
# than from the last application, are ours: nothing in the binary states which, because nothing in
# the binary checks it. Cancelling a pending application does not count as leaving, so "Cancel
# Join" is free; being banished does count, which is arguable and easy to change.
MGO2SERVER_CLAN_JOIN_COOLDOWN_HOURS=0


# ---------------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------------

# Connections each server process keeps. This is a per-process ceiling and the stack has NINE
# processes (gate, account, three Free Battle lobbies, automatching, two training lobbies, web),
# so the total is nine times this number against postgres's max_connections, which defaults to
# 100. At the old default of 10 that came to ~90 and the stack ran out on 2026-07-28 -- psql
# itself could not connect, with "sorry, too many clients already", after the Free Battle lobbies
# took the count from six processes to nine.
#
# Five is comfortable at nine processes (~45) and leaves room for psql and a tenth service.
# Raise postgres's max_connections instead if a lobby ever genuinely needs a deeper pool.
MGO2SERVER_DB_POOL_MAX_SIZE=5


# ---------------------------------------------------------------------------------------------
# Probes
#
# These exist to test a hypothesis against a live client without rebuilding the image. Each one
# is a value we do not fully understand; leave them blank unless you are actively sweeping.
# Blank means "use the built-in default", which is not the same as 0.
# ---------------------------------------------------------------------------------------------

# Third field of the login reply. See AuthWebController — the inherited value
# Array(10).fill("1000000").join("_") is genuinely what another server sends and genuinely wrong
# for this client, which is the whole reason this knob exists.
MGO2SERVER_LOGIN_PERKS=

# Five u16s for 0x43d1, comma-separated, e.g. 10,21,58,8,97. The count of five is protocol; the
# values are inherited and unexplained. The first is rendered on the training screen through
# message 847, so sweeping it is visible.
MGO2SERVER_TRAINING_PARAMS=

# Set to "off" to send every graduation as ungraded, bypassing the instructor branch entirely.
# A kill switch for when the graduation path is suspected of breaking a match.
MGO2SERVER_GRADUATION=

# Which mailbox category number carries announcements. 3 is what we send; 2 is the other
# candidate, and this exists to try it in one restart rather than a rebuild.
MGO2SERVER_MAIL_CATEGORY_ANNOUNCEMENT=

# The inbox and sent categories. Correct as far as anything has shown; here for symmetry.
MGO2SERVER_MAIL_CATEGORY_INBOX=
MGO2SERVER_MAIL_CATEGORY_SENT=



# ---------------------------------------------------------------------------------------------
# Automatching
#
# The automatching lobby is served on its own port and a player can walk into it today. Until
# these are set the server answers every search with the client's own "Automatching is currently
# not open", which is honest — the alternative, and what it used to do, was to accept the search
# and then never speak again, which the player experiences as a twenty-minute stopwatch.
#
# The game shipped four notices reading "Automatching will be held from %s" and "Automatching
# will finish shortly", so the original ran on a schedule rather than being permanently open.
# The schedule itself is not readable from anything we have, so these times are ours to choose.
# ---------------------------------------------------------------------------------------------

# Off by default. Setting this without a window below is a startup error rather than a server
# that is enabled and open never.
MGO2SERVER_AUTOMATCH_ENABLED=true

# Comma-separated HH:MM-HH:MM windows, e.g. 20:00-23:00,12:00-14:00. A range whose end is not
# after its start wraps midnight, so 22:00-02:00 is four hours.
#
# 00:00-00:00 therefore means ALWAYS OPEN, by that same wrap rule rather than as a special case.
# That is what is set below, for development. A real schedule goes here instead.
MGO2SERVER_AUTOMATCH_WINDOWS=00:00-00:00

# The zone the windows above are written in. Defaults to UTC, which is what the containers run,
# and is almost certainly not what you meant if you wrote the times by looking at a clock.
MGO2SERVER_AUTOMATCH_TIMEZONE=America/New_York

# BOTH or FORM_ONLY. Defaults to BOTH. They currently behave identically.
#
#   BOTH          form a game from the queue, and - once slot-in is built - try an existing game
#                 first. Today the slot-in pass does not exist, so this is FORM_ONLY.
#   FORM_ONLY     only ever form new games. Nothing happens until MIN_PLAYERS people are
#                 searching at the same time.
#   SLOT_IN_ONLY  NOT IMPLEMENTED. The server refuses to start with it, because it would leave
#                 the matchmaker inert rather than doing anything.
#
# Slot-in - dropping a searcher into a game already running - is parked as a future project. The
# case for it is three disc strings ("Searching for joinable games in progress", "Searching for
# open games"); the case against is that the only automatch behaviour anyone has actually observed
# is forming, with the rotation assembled from what the searchers asked for. Forming is what this
# server does.
MGO2SERVER_AUTOMATCH_MODE=

# Extra lobby ids whose games searchers may be slotted into, comma-separated. Empty means the
# automatching lobby alone.
#
# NO EFFECT TODAY - slot-in is not implemented (see MODE above). Kept because the validation and
# the parsing are already written and tested.
#
# Widening this is a policy invention with no evidence behind it — nothing says the original
# pulled players into Free Battle games. It is here because on a small server it is the
# difference between slot-in working and slot-in never firing. Lobby ids are in dev/tools/seed.sql
# and the compose file; the Free Battle lobbies are 4, 5 and 6.
MGO2SERVER_AUTOMATCH_SLOT_IN_LOBBIES=

# How many players a match holds out for, and how that requirement decays.
#
# A search starts wanting MIN_PLAYERS_START and gives up one player every
# MIN_PLAYERS_STEP_SECONDS until it reaches MIN_PLAYERS, its floor. The point is that a full game
# is better than a fast one: a search that immediately settles for two produces a duel when eight
# people were a minute away, and this biases early matches toward being worth playing without
# holding anyone out forever.
#
# This is also the number behind the client's "Players Needed" figure, so what a player watches
# counting down is the requirement genuinely falling rather than a display trick.
#
# Defaults: start 12, floor 2, one player every 30 seconds - so 12 walks down to 2 in five minutes,
# well inside the client's own ~20 minute search timeout.
#
# FOR TESTING with a small number of clients: set MIN_PLAYERS to the number of clients you have and
# shorten the step, or you will wait out the decay. Three clients with the default 30s step means
# 4.5 minutes before the requirement reaches 3. MIN_PLAYERS_STEP_SECONDS=5 makes that under a
# minute.
MGO2SERVER_AUTOMATCH_MIN_PLAYERS=
MGO2SERVER_AUTOMATCH_MIN_PLAYERS_START=
MGO2SERVER_AUTOMATCH_MIN_PLAYERS_STEP_SECONDS=

# Level matching. Each searcher carries their own window - their level plus or minus a band - and
# two players are matched when their windows TOUCH. The band starts narrow and widens the longer
# that particular player has waited, so a patient searcher reaches out to newcomers rather than
# both having to fit inside one shared range. The same number is sent to the client, which draws
# it as the lit range on the search gauge, so what the player sees is what the server is doing.
#
# Levels are 0-22. Defaults: start 1, widen by one level every 30 seconds, cap 22 - which reaches
# "anyone" in about eleven minutes, inside the client's own ~20-minute search timeout.
MGO2SERVER_AUTOMATCH_BAND_START=
MGO2SERVER_AUTOMATCH_BAND_STEP_SECONDS=
MGO2SERVER_AUTOMATCH_BAND_MAX=

# How often the matchmaker re-evaluates, in seconds. Default 5. The client's own request deadline
# is about 40 seconds and its search timeout about twenty minutes, so there is a lot of room here.
MGO2SERVER_AUTOMATCH_TICK_SECONDS=

# ---------------------------------------------------------------------------------------------
# Not here
#
# MGO2SERVER_LOG_LEVEL is set in compose.yaml, not this file, and putting it here would do
# nothing: compose gives `environment:` precedence over `env_file:`, so a service's own
# environment block wins. Override it for a run with `MGO2SERVER_LOG_LEVEL=INFO docker compose
# up -d`. The same goes for the per-lobby wiring — lobby type, id, subtype and game port are
# deployment topology rather than operator policy, and differ per container by design.
#
# MGO2SERVER_DB_PASSWORD is a secret and stays out of a committed file.
# ---------------------------------------------------------------------------------------------

# EXPERIMENT, off by default. Zeroes the four inherited constants that an exhaustive ELF sweep found
# have NO READER in this client build:
#
#   - automatch settings block +72 (0x02000000) and +179 (0x20)
#   - 0x4101's four u16 -- their only readers are four getters that nothing ever calls
#   - 0x4120's trailer bytes 8..31 (bytes 0-7 are now understood and sent as neutral zeros
#     regardless -- see GameplaySettingsWriter)
#
# Deliberately NOT included, because it is read: the 0x3049 trailer, whose index-3 bit 0 unlocks 32
# of the 91 loadout items. Zeroing that one empties a third of the loadout screen.
#
# The point is to test the sweep against a real client, not to change what we ship. The sweep has a
# stated limit: a reader that stashed the struct pointer in memory and reloaded it into an untracked
# register would have been missed.
#
# WHAT COUNTS AS A RESULT. "Nothing crashed" is weak -- these are settings and display fields, and
# absence of a crash is what you would see either way. Check the specific screens instead: character
# select and the character-info card (0x4101), the settings/preferences screen and any sorted list
# (0x4120), and create/join an automatch game to the point of play (the settings block). A visible
# difference in any of those means the sweep missed a reader, which is the finding worth having.
MGO2SERVER_EXPERIMENT_ZERO_UNREAD_FIELDS=

# PROBE, off by default. The Rankings player card shows PLAY TIME 00:00:00 while More Details shows
# the right figure. Diagnosis: that card is fed by 0x4103, NOT 0x4221 -- a live capture shows the
# client sends 0x4102 and never sends 0x4220 from this screen. We only put a real play time in
# 0x4221 (never requested here) and 0x4105's grid (which the client sums for the More Details
# header), so the card's own field is one of 0x4103's unknown u32 slots and we send zero.
#
# Turning this on fills four candidate slots with distinct, unmistakable clock values. Open the
# Rankings card and read PLAY TIME:
#
#   01:00:00 -> T+0x1AD0     02:00:00 -> T+0x1DEC
#   03:00:00 -> T+0x1E20     04:00:00 -> T+0x124
#
# Whichever appears names the field, and we then send the real value there. If none appears, the
# next candidates are the five-u32 block at T+0x1E08 and the obj+0x30 slot.
#
# Guessing instead of probing is how a fingerprint string once minted 17 unearned medals -- these
# slots feed award logic, so they get one deliberate value each rather than a plausible-looking one.
MGO2SERVER_EXPERIMENT_PROBE_4103_PLAYTIME=
